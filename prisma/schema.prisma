generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          Int      @id @default(autoincrement())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([name])
}

model SensorReading {
  id          String   @id @default(cuid())
  pressure    Float
  temperature Float
  timestamp   DateTime @default(now())
  deviceId    String
  userId      String
  // Multi-sensor support
  sensorType  String   @default("pressure_differential")
  humidity    Float?   // %RH
  co2         Float?   // ppm
  voc         Float?   // ppb
  device      Device   @relation(fields: [deviceId], references: [deviceId])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([deviceId])
  @@index([deviceId, sensorType])
}

// Registry of supported sensor types
model SensorTypeConfig {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "pressure_differential", "humidity", "co2"
  name        String  // Display name: "Differential Pressure"
  unit        String  // e.g. "Pa", "%RH", "ppm"
  description String?
  isBuiltIn   Boolean @default(false)

  @@index([key])
}

model Device {
  id                String                 @id @default(cuid())
  deviceId          String                 @unique
  name              String?
  location          String?
  type              String                 @default("SmartFilter")
  firmware          String?
  apiToken          String                 @unique
  status            String                 @default("pending")
  lastSeen          DateTime               @default(now())
  userId            String?
  pressureThreshold Float                  @default(50.0) // Pa - trigger filter alert when exceeded
  deviceSecretHash  String?                // sha256 of the secret the device presents to re-fetch its token
  // Energy model — filter cost tracking
  blowerType           String    @default("ecm") // "ecm" (variable-speed) or "psc" (fixed-speed)
  airflowCfm           Float     @default(1000)  // rated system airflow
  electricityRateCents Float     @default(15)    // ¢ per kWh
  baselineDeltaP       Float?    // Pa across a clean filter, captured after install/replacement
  filterInstalledAt    DateTime?
  runtimeHours         Float     @default(0)     // blower runtime since filter install
  extraEnergyCostCents Float     @default(0)     // cumulative extra energy cost vs clean filter
  lastAccrualAt        DateTime? // previous reading time used for accrual integration
  // Furnace / air-handler identity (user-entered or photo-identified)
  furnaceMake          String?   // e.g. "Carrier"
  furnaceModel         String?   // e.g. "59TP6B080V17"
  // Battery / reporting cadence (battery firmware batches uploads)
  batteryPct           Float?    // last reported battery %, null = wall-powered
  reportingIntervalMin Int       @default(1)     // expected minutes between check-ins
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User?                  @relation(fields: [userId], references: [id])
  sensorReadings    SensorReading[]
  filterPreferences UserFilterPreference[]
  filterAlerts      FilterAlert[]

  @@index([userId])
  @@index([status])
  @@index([deviceId])
}

model ProvisioningSession {
  id           String   @id @default(cuid())
  deviceId     String
  sessionToken String   @unique
  status       String   @default("pending")
  expiresAt    DateTime
  userId       String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([deviceId])
  @@index([sessionToken])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime               @default(now())
  hasPassword           Boolean                @default(false)
  password              String?
  isAdmin               Boolean                @default(false)
  stripeCustomerId      String?                @unique
  stripeDefaultPaymentMethodId String?
  // Shipping address on file (used for auto-orders)
  shippingName          String?
  shippingAddress1      String?
  shippingAddress2      String?
  shippingCity          String?
  shippingState         String?
  shippingZip           String?
  shippingCountry       String                 @default("US")
  updatedAt             DateTime               @default(now()) @updatedAt
  accounts              Account[]
  devices               Device[]
  posts                 Post[]
  provisioningSessions  ProvisioningSession[]
  sensorReadings        SensorReading[]
  sessions              Session[]
  orders                Order[]
  filterPreferences     UserFilterPreference[]
  filterAlerts          FilterAlert[]
  apiKeys               ApiKey[]
  webhooks              Webhook[]
  oauthCodes            OAuthAuthorizationCode[]
  oauthTokens           OAuthToken[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Store Models

model FilterProduct {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  size        String   // e.g., "20x20x1", "16x25x1"
  width       Float    // inches
  height      Float    // inches
  depth       Float    // inches
  merv        Int?     // MERV rating (1-16)
  price       Int      // Price in cents
  imageUrl    String?
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems         OrderItem[]
  userPreferences    UserFilterPreference[]

  @@index([size])
  @@index([inStock])
}

model UserFilterPreference {
  id              String   @id @default(cuid())
  userId          String
  deviceId        String?  // Optional: specific device, or null for default
  filterProductId String
  autoOrderEnabled Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?       @relation(fields: [deviceId], references: [id])
  filterProduct FilterProduct @relation(fields: [filterProductId], references: [id])

  @@unique([userId, deviceId])
  @@index([userId])
}

model Order {
  id                  String   @id @default(cuid())
  userId              String
  status              String   @default("pending") // pending, paid, shipped, delivered, cancelled
  stripePaymentIntent String?  @unique
  stripeSessionId     String?  @unique
  subtotal            Int      // cents
  tax                 Int      @default(0) // cents
  shipping            Int      @default(0) // cents
  total               Int      // cents
  // Shipping address
  shippingName        String?
  shippingAddress1    String?
  shippingAddress2    String?
  shippingCity        String?
  shippingState       String?
  shippingZip         String?
  shippingCountry     String   @default("US")
  // Auto-order fields
  isAutoOrder         Boolean  @default(false)
  triggeredByAlertId  String?  // Link to the FilterAlert that triggered this
  // Fulfillment
  trackingNumber      String?
  shippedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([stripePaymentIntent])
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  filterProductId String
  quantity        Int    @default(1)
  priceAtPurchase Int    // cents - snapshot of price when ordered

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  filterProduct FilterProduct @relation(fields: [filterProductId], references: [id])

  @@index([orderId])
}

model FirmwareRelease {
  id           String   @id @default(cuid())
  version      String   @unique // semver e.g. "1.0.1"
  binaryUrl    String   // URL to firmware binary (e.g. GitHub Releases)
  releaseNotes String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([isActive])
}

// Public API & Webhooks

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String    // e.g. "Home Assistant"
  key       String    @unique // sk_live_[64-char-hex]
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model Webhook {
  id        String    @id @default(cuid())
  userId    String
  name      String
  url       String
  events    String[]  // e.g. ["filter.alert","device.offline","reading.threshold"]
  secret    String    // HMAC-SHA256 signing secret
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deliveries WebhookDelivery[]
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  status     String   @default("pending") // pending, success, failed
  statusCode Int?
  response   String?
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
}

// Smart-home OAuth bridge (Google Home / Alexa / SmartThings account linking)

model OAuthClient {
  id               String   @id @default(cuid())
  clientId         String   @unique // public identifier, oc_[hex]
  clientSecretHash String   // sha256 of the secret (shown once at creation)
  name             String   // e.g. "Google Home", "Alexa", "SmartThings"
  redirectUris     String[] // exact-match allowlist
  createdAt        DateTime @default(now())

  authCodes OAuthAuthorizationCode[]
  tokens    OAuthToken[]
}

model OAuthAuthorizationCode {
  id          String    @id @default(cuid())
  codeHash    String    @unique // sha256 of the code sent to the client
  clientId    String
  userId      String
  redirectUri String
  scope       String    @default("devices:read")
  expiresAt   DateTime  // short-lived (10 min)
  usedAt      DateTime? // single-use
  createdAt   DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthToken {
  id               String    @id @default(cuid())
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  clientId         String
  userId           String
  scope            String    @default("devices:read")
  accessExpiresAt  DateTime  // access token lifetime (1 h); refresh until revoked
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

model FilterAlert {
  id             String    @id @default(cuid())
  deviceId       String
  userId         String
  pressure       Float     // Differential pressure reading that triggered alert
  threshold      Float     // The threshold that was exceeded
  status         String    @default("pending") // pending, notified, auto_ordered, dismissed, manual_ordered, payment_failed
  autoOrderAt    DateTime? // When auto-order will execute (if enabled)
  cancelToken    String?   @unique // one-click cancel link token for alert emails
  notifiedAt     DateTime? // When user was notified
  resolvedAt     DateTime? // When alert was resolved (order placed or dismissed)
  createdAt      DateTime  @default(now())

  device Device @relation(fields: [deviceId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([status])
}
